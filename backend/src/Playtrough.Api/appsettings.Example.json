{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Playtrough",
    "Audience": "PlaytroughClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "PasswordReset": {
    "FrontendBaseUrl": "http://localhost:4200",
    "TokenLifespanMinutes": 60
  },
  "EmailConfirmation": {
    "TokenLifespanMinutes": 60,
    "ResendCooldownSeconds": 60
  },
  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@example.com",
    "FromName": "Playtrough",
    "SecureSocketMode": "None",
    "TimeoutSeconds": 15
  },
  "RawgSettings": {
    "Enabled": false,
    "ApiKey": "",
    "BaseUrl": "https://api.rawg.io/api",
    "MaxRequestsPerSecond": 5,
    "RequestTimeoutSeconds": 10,
    "SearchCacheMinutes": 10,
    "DetailCacheMinutes": 1440
  },
  "Catalog": {
    "UseFake": false,
    "RefreshAfterDays": 30
  },
  "AdminSeed": {
    "Username": "",
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Transport": {
    "MaxRequestBodySizeBytes": 1048576,
    "HttpsPort": 443,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimit": {
    "Enabled": true,
    "Login": { "PermitLimit": 10, "Window": "00:01:00" },
    "Register": { "PermitLimit": 5, "Window": "01:00:00" },
    "PasswordRecovery": { "PermitLimit": 5, "Window": "00:15:00" },
    "TokenActions": { "PermitLimit": 10, "Window": "00:15:00" },
    "Refresh": { "PermitLimit": 30, "Window": "00:01:00" },
    "Catalog": { "PermitLimit": 30, "Window": "00:01:00" },
    "Global": { "PermitLimit": 100, "Window": "00:01:00" }
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
