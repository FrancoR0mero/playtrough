{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "Playtrough",
    "Audience": "PlaytroughClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "Key": ""
  },
  "PasswordReset": {
    "TokenLifespanMinutes": 60,
    "FrontendBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Transport": {
    "MaxRequestBodySizeBytes": 1048576,
    "HttpsPort": 443,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimit": {
    "Enabled": true,
    "Login": { "PermitLimit": 10, "Window": "00:01:00" },
    "Register": { "PermitLimit": 5, "Window": "01:00:00" },
    "PasswordRecovery": { "PermitLimit": 5, "Window": "00:15:00" },
    "TokenActions": { "PermitLimit": 10, "Window": "00:15:00" },
    "Refresh": { "PermitLimit": 30, "Window": "00:01:00" },
    "Global": { "PermitLimit": 100, "Window": "00:01:00" }
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Enabled": true,
    "Host": "",
    "Port": 0,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Playtrough",
    "SecureSocketMode": "StartTls",
    "TimeoutSeconds": 15
  },
  "EmailConfirmation": {
    "TokenLifespanMinutes": 60,
    "ResendCooldownSeconds": 60
  }
}
